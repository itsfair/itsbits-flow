# Copy to `production.env` (same directory, gitignored) and fill in ALL
# values. NEVER commit production.env.
#
# These keys override config/passwords.yaml for the production run mode
# (Serverpod's SERVERPOD_PASSWORD_<key> convention). Generate fresh
# random values for every secret.
#
# Serverpod core passwords:
SERVERPOD_PASSWORD_database=
SERVERPOD_PASSWORD_serviceSecret=
# Peppers/keys ONLY required if the LOCAL instance issues its own user
# logins (it does: site admin/staff JWT logins):
SERVERPOD_PASSWORD_emailSecretHashPepper=
SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey=
SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper=
# AES key source for encrypting the device session key at rest
# (site_connections.deviceSessionKey) — WITHOUT it the key is stored in
# PLAINTEXT; always set a fresh random value per deployment.
SERVERPOD_PASSWORD_siteDeviceKeyCipherPassword=

# Instance wiring (deployment values): this instance must reach the
# GLOBAL API for setup/sync, and the ESP doorinterfaces reach THIS web
# server (REST routes incl. /api/door/verify) from the LAN:
SERVERPOD_PASSWORD_globalApiUrl=http://<global-api-host>:8080
SERVERPOD_PASSWORD_localApiUrl=http://<this-machines-lan-ip>:8182

# RustFS (S3): endpoint must be reachable by admin-app browsers in the
# site LAN (presigned image URLs are assembled per payload). Rotate off
# the rustfsadmin/rustfsadmin_secret dev defaults for shared deployments
# — these two values MUST equal the RUSTFS_ACCESS_KEY/SECRET_KEY the
# stack's rustfs/create_buckets services receive.
SERVERPOD_RUSTFS_ENDPOINT=http://<this-machines-lan-ip>:9200
SERVERPOD_RUSTFS_ACCESS_KEY=
SERVERPOD_RUSTFS_SECRET_KEY=

# NOTE: no SMTP keys here — the local instance does not send verification
# mails yet (it still uses the Serverpod-Cloud email config which is a
# no-op self-hosted). Local email flows are a backlog item.