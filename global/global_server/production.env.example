# Copy to `production.env` (same directory, gitignored) and fill in ALL
# values. NEVER commit production.env.
#
# These keys override config/passwords.yaml for the production run mode
# (Serverpod's SERVERPOD_PASSWORD_<key> convention). Generate fresh
# random values for every secret — the values from config/passwords.yaml
# production block are a fallback only if you deliberately want to reuse
# them.
#
# Serverpod core passwords:
SERVERPOD_PASSWORD_database=
SERVERPOD_PASSWORD_serviceSecret=
SERVERPOD_PASSWORD_emailSecretHashPepper=
SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey=
SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper=
# SAS session-key pepper for site-device method streams (GlobalSiteConnection /
# SiteDeviceAuthentication) — MUST match the global deployment value
SERVERPOD_PASSWORD_serverSideSessionKeyHashPepper=

# SMTP for registration/password-reset verification mails — WITHOUT
# smtpHost the codes are ONLY logged (fail-open dev fallback; registration
# rethrows the send error, so users CANNOT finish signup without SMTP).
SERVERPOD_PASSWORD_smtpHost=
SERVERPOD_PASSWORD_smtpPort=587
SERVERPOD_PASSWORD_smtpSsl=false
SERVERPOD_PASSWORD_smtpAllowInsecure=false
SERVERPOD_PASSWORD_smtpUsername=
SERVERPOD_PASSWORD_smtpPassword=
SERVERPOD_PASSWORD_smtpFromAddress=
SERVERPOD_PASSWORD_smtpFromName=itsbits - flow

# RustFS (S3): SERVERPOD_RUSTFS_ENDPOINT must be reachable by browser
# clients too (presigned image URLs travel in payloads). Rotate off the
# rustfsadmin/rustfsadmin_secret dev defaults for shared deployments —
# these two values MUST equal the RUSTFS_ACCESS_KEY/SECRET_KEY the
# stack's rustfs/create_buckets services receive.
SERVERPOD_RUSTFS_ENDPOINT=http://<prod-host>:9000
SERVERPOD_RUSTFS_ACCESS_KEY=
SERVERPOD_RUSTFS_SECRET_KEY=