{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serverpod_global": {
      "type": "local",
      "command": ["serverpod", "mcp-server", "--server-dir", "global/global_server"],
      "enabled": true
    },
    "serverpod_local": {
      "type": "local",
      "command": ["serverpod", "mcp-server", "--server-dir", "local/local_server"],
      "enabled": true
    },
    "dart-mcp-server": {
      "type": "local",
      "command": ["dart", "mcp-server"],
      "enabled": true,
      "environment": {}
    }
  }
}
